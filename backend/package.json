{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "nodemon --watch src --exec \"node --no-warnings --loader ts-node/esm src/index.ts\"",
    "dev:ws": "nodemon --watch src --exec \"node --no-warnings --loader ts-node/esm src/websockets.ts\"",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:ws\"",
    "deploy:ws": "node dist/websockets.js",
    "deploy": "node dist/index.js",
    "deploy:all": "npx prisma migrate deploy && concurrently \"npm run deploy\" \"npm run deploy:ws\"",
    "build": "npx tsc -b",
    "generate:db": "npx prisma generate"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
